<Window x:Class="KHSX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KHSX"
        xmlns:viewmodels="clr-namespace:KHSX.ViewModels"
        xmlns:models="clr-namespace:KHSX.Models"
        mc:Ignorable="d"
        Title="Hệ thống Lập Kế Hoạch Sản Xuất" Height="768" Width="1366"
        WindowState="Maximized">
    <Window.DataContext>
        <viewmodels:MainViewModel x:Name="ViewModel"/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Define converters FIRST -->
        <local:BoolToRedBorderConverter x:Key="BoolToRedBorderConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:WeekendColorConverter x:Key="WeekendColorConverter"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        
        <!-- Then define DataTemplate that uses them -->
        <DataTemplate DataType="{x:Type models:ProductBlock}">
            <Border Background="{Binding DisplayColor}" 
                    BorderBrush="{Binding IsExceedingDeadline, Converter={StaticResource BoolToRedBorderConverter}}" 
                    BorderThickness="1" 
                    Margin="2" 
                    Padding="5" 
                    CornerRadius="3"
                    MouseMove="ProductBlock_MouseMove">
                <TextBlock Text="{Binding DisplayText}" FontWeight="Bold" Foreground="DarkSlateGray"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#f0f0f0" BorderBrush="#ccc" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <Button Content="Import Excel (pivot openmin)" Command="{Binding ImportExcelCommand}" Padding="10,5" Margin="0,0,20,0"/>
                <TextBlock Text="Ngày Deadline: " VerticalAlignment="Center" FontWeight="Bold"/>
                <DatePicker SelectedDate="{Binding DeadlineDate, Mode=TwoWay}" Width="150" Margin="5,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Unassigned Blocks -->
            <Border Grid.Column="0" BorderBrush="#ccc" BorderThickness="0,0,1,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Sản phẩm chưa gán" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding UnassignedBlocks}">
                            <!-- Sử dụng DataTemplate đã khai báo ở trên -->
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#eee"/>

            <!-- Right Panel: Gantt Chart -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Lines}" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ProductionLine}">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Line Name -->
                                <Border Background="#ddd" BorderBrush="#aaa" BorderThickness="1" Padding="5">
                                    <TextBlock Text="{Binding LineName}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>

                                <!-- Days in Line -->
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:DayCell}">
                                            <Border Width="120" Height="80" 
                                                    BorderBrush="#aaa" BorderThickness="1" 
                                                    Background="{Binding IsWeekend, Converter={StaticResource WeekendColorConverter}}"
                                                    AllowDrop="{Binding IsWeekend, Converter={StaticResource InverseBoolConverter}}"
                                                    Drop="DayCell_Drop" DragEnter="DayCell_DragEnter"
                                                    Tag="{Binding}">
                                                
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Vạch đỏ nếu là Deadline -->
                                                    <Border Grid.RowSpan="2" BorderThickness="3,0,0,0" BorderBrush="Red" 
                                                            Visibility="{Binding IsDeadline, Converter={StaticResource BoolToVisibilityConverter}}" 
                                                            HorizontalAlignment="Right" Panel.ZIndex="10"/>

                                                    <!-- Date Header -->
                                                    <TextBlock Grid.Row="0" Text="{Binding Date, StringFormat=dd/MM}" HorizontalAlignment="Center" Foreground="#555" FontSize="10" Margin="0,2,0,0"/>
                                                    
                                                    <!-- Watermark Ca A | Ca B | Tổng -->
                                                    <TextBlock Grid.Row="1" Text="{Binding WatermarkText}" 
                                                               Foreground="#d0d0d0" FontSize="10" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                               Margin="0,0,0,2" Panel.ZIndex="0"/>

                                                    <!-- Assigned Blocks -->
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Blocks}" Panel.ZIndex="1">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Vertical"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

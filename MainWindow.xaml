<ui:FluentWindow x:Class="KHSX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KHSX"
        xmlns:converters="clr-namespace:KHSX.Converters"
        xmlns:viewmodels="clr-namespace:KHSX.ViewModels"
        xmlns:models="clr-namespace:KHSX.Models"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        mc:Ignorable="d"
        Title="Hệ thống Lập Kế Hoạch Sản Xuất" Height="768" Width="1366"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Icon="Assets/logo.png">
    <Window.DataContext>
        <viewmodels:MainViewModel x:Name="ViewModel"/>
    </Window.DataContext>

    <Window.Resources>
        <CollectionViewSource x:Key="SortedUnassignedBlocks" Source="{Binding UnassignedBlocks}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Code" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <!-- Define converters FIRST -->
        <converters:BoolToRedBorderConverter x:Key="BoolToRedBorderConverter"/>
        <converters:BoolToBorderThicknessConverter x:Key="BoolToBorderThicknessConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:WeekendColorConverter x:Key="WeekendColorConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:CustomConfigBackgroundConverter x:Key="CustomConfigBackgroundConverter"/>
        <converters:DayCellBackgroundConverter x:Key="DayCellBackgroundConverter"/>
        <converters:PercentageToWidthConverter x:Key="PercentageToWidthConverter"/>

        
        <!-- DataTemplate mặc định cho block trên grid -->
        <DataTemplate DataType="{x:Type models:ProductBlock}">
            <Border Background="{Binding DisplayColor}" 
                    BorderBrush="{Binding IsExceedingDeadline, Converter={StaticResource BoolToRedBorderConverter}}" 
                    BorderThickness="{Binding IsExceedingDeadline, Converter={StaticResource BoolToBorderThicknessConverter}}" 
                    Margin="2" 
                    Padding="5" 
                    CornerRadius="3"
                    MouseMove="ProductBlock_MouseMove"
                    Cursor="Hand"
                    ToolTip="{Binding TooltipText}">
                <TextBlock Text="{Binding DisplayText}" FontWeight="Bold" Foreground="DarkSlateGray"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ui:TitleBar Title="Hệ thống Lập Kế Hoạch Sản Xuất" Icon="Assets/logo.png" />
            <ui:Button Icon="{ui:SymbolIcon WeatherMoon24}" Click="ThemeToggle_Click" Background="Transparent" BorderBrush="Transparent" Margin="0,0,150,0" HorizontalAlignment="Right" VerticalAlignment="Center" Panel.ZIndex="10"/>
        </Grid>

        <!-- Menu Bar -->
        <Menu Grid.Row="1" Background="Transparent" Padding="2">
            <MenuItem Header="📂 Nhập Dữ Liệu">
                <MenuItem Header="Import Marketing" Command="{Binding ImportMarketingCommand}"/>
                <MenuItem Header="Import MES → Tạo Block" Command="{Binding ImportMESCommand}"/>
            </MenuItem>
            <MenuItem Header="⚙️ Cấu Hình">
                <MenuItem Header="Thiết Lập Deadline" Command="{Binding ConfigDeadlinesCommand}"/>
                <MenuItem Header="Cấu Hình Groups (Marketing)" Command="{Binding ConfigGroupsCommand}"/>
                <MenuItem Header="Thứ tự SP" Command="{Binding ConfigProductOrderCommand}"/>
                <Separator/>
                <MenuItem Header="➕ Thêm Line" Command="{Binding AddLineCommand}"/>
            </MenuItem>
            <MenuItem Header="🔧 Hành Động">
                <MenuItem Header="💾 Lưu cấu hình" Command="{Binding SaveConfigurationCommand}"/>
                <Separator/>
                <MenuItem Header="🗑️ Xoá Toàn Bộ" Command="{Binding ClearAllBlocksCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Compact Toolbar -->
        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="📥 Xuất Kế Hoạch" Command="{Binding ExportPlanCommand}" 
                        Padding="12,6" Appearance="Primary" Margin="0,0,20,0"
                        ToolTip="Xuất kế hoạch sản xuất ra file Excel"/>
                <TextBlock Text="Ngày Bắt Đầu: " VerticalAlignment="Center" FontWeight="Bold"/>
                <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Width="230" Margin="5,0"/>
                <Border Width="1" Background="#ccc" Margin="10,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="150"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Unassigned Blocks -->
            <Border Grid.Column="0" BorderBrush="#ccc" BorderThickness="0,0,1,0" Padding="10" x:Name="LeftPanel"
                    AllowDrop="True" Drop="UnassignedPanel_Drop" DragEnter="UnassignedPanel_DragEnter">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Sản phẩm chưa gán" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="UnassignedScrollViewer">
                        <ItemsControl ItemsSource="{Binding Source={StaticResource SortedUnassignedBlocks}}" x:Name="UnassignedItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ProductBlock}">
                                    <Border Background="{Binding DisplayColor}" 
                                            BorderBrush="{Binding IsExceedingDeadline, Converter={StaticResource BoolToRedBorderConverter}}" 
                                            BorderThickness="1" 
                                            Margin="2" 
                                            Padding="5" 
                                            CornerRadius="3"
                                            HorizontalAlignment="Left"
                                            MouseMove="ProductBlock_MouseMove"
                                            Cursor="Hand"
                                            ToolTip="{Binding DisplayText}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                                <Binding Path="WidthPercentage"/>
                                                <Binding Path="ActualWidth" ElementName="UnassignedScrollViewer"/>
                                            </MultiBinding>
                                        </Border.Width>
                                        <TextBlock Text="{Binding DisplayText}" 
                                                   FontWeight="Bold" 
                                                   Foreground="DarkSlateGray" 
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource ControlFillColorTertiaryBrush}"/>

            <!-- Right Panel: Gantt Chart -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <!-- Nav Bar Thống kê số người -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" Padding="5">
                            <TextBlock Text="Tổng người/ngày" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>
                        
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding DaySummaries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DaySummary}">
                                    <Border Width="120" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" Padding="0">
                                        <TextBlock Text="{Binding DisplayText}" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Rows}" AlternationCount="2">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ShiftRow}">
                            <Grid Margin="0,0,0,10">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                                <Setter Property="Background" Value="{DynamicResource LayerOnLayerFillColorDefaultBrush}"/> <!-- Màu nền xen kẽ (xanh lam siêu nhạt) -->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Line Name -->
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" Padding="5"
                                        Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBox Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                                 Text="{Binding DisplayIndex, UpdateSourceTrigger=PropertyChanged}" 
                                                 LostFocus="DisplayIndex_LostFocus" KeyDown="DisplayIndex_KeyDown"
                                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 FontWeight="Bold" FontSize="14" Margin="0,0,5,0"
                                                 ToolTip="Số thứ tự xếp hạng (Có thể chỉnh sửa tuỳ ý)"/>
                                        
                                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding RowName}" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MouseLeftButtonDown="LineName_DoubleClick"
                                                   Cursor="Hand"
                                                   ToolTip="Click để đổi tên và cấu hình ca"/>
                                        
                                        <ui:Button Grid.Column="1" Grid.Row="1" Content="🗑️" 
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Width="60" Height="25" Margin="0,5,0,0"
                                                Appearance="Danger"
                                                FontSize="12" Padding="2"
                                                ToolTip="Xóa Line"/>
                                    </Grid>
                                </Border>

                                <!-- Days in Line -->
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:DayCell}">
                                            <Border x:Name="CellBorder" Width="120" Height="100" 
                                                    AllowDrop="{Binding IsDayOff, Converter={StaticResource InverseBoolConverter}}"
                                                    Drop="DayCell_Drop" DragEnter="DayCell_DragEnter"
                                                    MouseRightButtonUp="DayCell_RightClick"
                                                    Tag="{Binding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#aaa"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAvailableCapacity}" Value="True">
                                                                <Setter Property="BorderBrush" Value="Gold"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource DayCellBackgroundConverter}">
                                                        <Binding Path="IsDayOff"/>
                                                        <Binding Path="HasCustomConfig"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                                
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Vạch đỏ nếu là Deadline -->
                                                    <Border Grid.RowSpan="2" BorderThickness="3,0,0,0" BorderBrush="Red" 
                                                            Visibility="{Binding IsDeadline, Converter={StaticResource BoolToVisibilityConverter}}" 
                                                            HorizontalAlignment="Right" Panel.ZIndex="10"/>

                                                    <!-- Date Header -->
                                                    <TextBlock Grid.Row="0" Text="{Binding Date, StringFormat=dd/MM}" HorizontalAlignment="Center" Foreground="#555" FontSize="10" Margin="0,2,0,0"/>
                                                    
                                                    <!-- Watermark Ca A | Ca B | Tổng -->
                                                    <TextBlock Grid.Row="1" Text="{Binding WatermarkText}" 
                                                               Foreground="#888" FontSize="9" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                               Margin="0,0,0,2" Panel.ZIndex="0" TextWrapping="Wrap"/>

                                                    <!-- Assigned Blocks -->
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Blocks}" Panel.ZIndex="1" VerticalAlignment="Stretch">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid VerticalAlignment="Top"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type models:ProductBlock}">
                                                                <Border Background="{Binding DisplayColor}" 
                                                                        BorderBrush="{Binding IsExceedingDeadline, Converter={StaticResource BoolToRedBorderConverter}}" 
                                                                        BorderThickness="{Binding IsExceedingDeadline, Converter={StaticResource BoolToBorderThicknessConverter}}" 
                                                                        Margin="1" 
                                                                        Padding="2" 
                                                                        CornerRadius="3"
                                                                        MouseMove="ProductBlock_MouseMove"
                                                                        Cursor="Hand"
                                                                        ToolTip="{Binding TooltipText}">
                                                                    <!-- Chiều rộng tự động chia trong WrapPanel hoặc UniformGrid -->
                                                                    <TextBlock Text="{Binding DisplayText}" 
                                                                               FontWeight="Bold" 
                                                                               Foreground="DarkSlateGray" 
                                                                               FontSize="9"
                                                                               LineHeight="10"
                                                                               TextWrapping="Wrap"
                                                                               TextAlignment="Center"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>

<Window x:Class="KHSX.Views.ExportOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sắp xếp thứ tự BuildGroup trước khi Export"
        Width="500" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="400" MinHeight="350"
        Background="#F5F5F5">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Sắp xếp thứ tự BuildGroup cho các ca có nhiều hơn 1 BuildGroup:" 
                   FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"
                   TextWrapping="Wrap"/>

        <!-- Lines with blocks -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="LinesPanel">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="6"
                                Margin="0,0,0,12" Padding="10" Background="White">
                            <StackPanel>
                                <TextBlock Text="{Binding LineName}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <ListBox x:Name="BlockList" ItemsSource="{Binding Blocks}"
                                         SelectionMode="Single" MinHeight="40"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayText}" 
                                                           VerticalAlignment="Center" FontSize="12"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="▲" Width="28" Height="28" Margin="2"
                                                            Tag="{Binding}" Click="MoveBlockUp_Click"
                                                            ToolTip="Di chuyển lên"/>
                                                    <Button Content="▼" Width="28" Height="28" Margin="2"
                                                            Tag="{Binding}" Click="MoveBlockDown_Click"
                                                            ToolTip="Di chuyển xuống"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy" Width="80" Height="32" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Xác nhận &amp; Export" Width="140" Height="32" 
                    FontWeight="SemiBold" Background="#2196F3" Foreground="White"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="KHSX.Views.EditShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <DockPanel Margin="20">
        <!-- Button Panel -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ResetButton" Content="Reset về mặc định" Width="120" Height="30" 
                    Margin="0,0,10,0" Background="#FF9800" Foreground="White"
                    Click="Reset_Click" Visibility="Collapsed"/>
            <Button x:Name="ApplyAllButton" Content="Áp dụng cho tất cả ngày" Width="140" Height="30" 
                    Margin="0,0,10,0" Background="#2196F3" Foreground="White"
                    Click="ApplyAll_Click"/>
            <Button Content="Lưu" Width="80" Height="30" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="Hủy" Width="80" Height="30" Click="Cancel_Click"/>
        </StackPanel>

        <!-- Content -->
        <StackPanel>
            <!-- Mass Action Panel (chỉ hiện khi chỉnh sửa DayCell) -->
            <StackPanel x:Name="MassActionPanel" Margin="0,0,0,15" Background="#F0F0F0" Visibility="Collapsed">
                <TextBlock Text="CÀI ĐẶT NHANH CHO TẤT CẢ CÁC LINE (CÙNG NGÀY)" 
                           FontWeight="Bold" Padding="5" Background="LightGray"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                    <Button Content="🔴 NGHỈ TOÀN BỘ" Width="135" Height="35" 
                            Margin="0,0,10,0" Background="Crimson" Foreground="White" 
                            FontWeight="Bold" Click="MassOff_Click"/>
                    <Button Content="🟢 LÀM TOÀN BỘ" Width="135" Height="35" 
                            Background="ForestGreen" Foreground="White" 
                            FontWeight="Bold" Click="MassWork_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Day Off Toggle (chỉ hiện khi chỉnh sửa DayCell) -->
            <StackPanel x:Name="DayOffPanel" Margin="0,0,0,15" Visibility="Collapsed">
                <TextBlock x:Name="StatusBlock" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <CheckBox x:Name="ToggleDayOffCheckBox" 
                          Content="Cài đặt trạng thái Ngày này thành NGÀY NGHỈ"
                          FontSize="13" Margin="0,0,0,5"
                          Checked="DayOff_Checked" Unchecked="DayOff_Unchecked"/>
            </StackPanel>
            <Separator x:Name="DayOffSeparator" Margin="0,0,0,10" Visibility="Collapsed"/>

            <!-- Line Name (chỉ hiện khi chỉnh sửa Line) -->
            <StackPanel x:Name="LineNamePanel" Visibility="Collapsed">
                <TextBlock Text="TÊN CA LÀM VIỆC" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Tên:" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="LineNameBox" Width="300" FontSize="14"/>
                </StackPanel>
            </StackPanel>

            <!-- Config Info Text -->
            <TextBlock x:Name="InfoText" TextWrapping="Wrap" Margin="0,0,0,15" FontStyle="Italic" FontWeight="Bold"/>

            <!-- Shift Config -->
            <StackPanel x:Name="ConfigSection">
                <TextBlock Text="Cấu hình ca" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                
                <!-- Workers -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Số người:" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="WorkersBox" Width="100" LostFocus="WorkersBox_LostFocus"/>
                </StackPanel>

                <!-- Minutes -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Số phút/người:" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="MinutesBox" Width="100" LostFocus="MinutesBox_LostFocus"/>
                </StackPanel>

                <!-- Efficiency -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Hiệu suất:" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="EfficiencyBox" Width="100"/>
                    <TextBlock Text="  (VD: 1.15 = 115%)" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <Separator Margin="0,10,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>

<ui:FluentWindow x:Class="KHSX.Views.ConfigGroupsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Cấu Hình Product Groups"
        Width="600" Height="520"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ResizeMode="CanResize"
        MinHeight="300"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Cấu Hình Product Groups" />
        <DockPanel Grid.Row="1" Margin="20">
        <!-- Header Info -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">
            <TextBlock Text="Cập nhật Tên hiển thị và Production Group (Gr.xxx) mặc định cho mỗi nhóm sản phẩm."
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Build Group" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="function" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="Gr.xxx Mặc Định" FontWeight="Bold"/>
            </Grid>
        </StackPanel>

        <!-- Button Panel -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <ComboBox x:Name="GlobalGroupSelector" MinWidth="100" Padding="8,4" 
                      Margin="0,0,10,0" VerticalContentAlignment="Center"/>
            <Button Content="Áp dụng cho tất cả" Padding="15,6" MinWidth="130" 
                    Margin="0,0,10,0" Background="#FF9800" Foreground="White"
                    Click="SetAllGroups_Click"/>
            <Button Content="Lưu Cập Nhật" Padding="15,6" MinWidth="100" 
                    Margin="0,0,10,0" Background="#2196F3" Foreground="White"
                    Click="Save_Click"/>
            <Button Content="Hủy" Padding="15,6" MinWidth="80" Click="Cancel_Click"/>
        </StackPanel>

        <!-- Scrollable Grid Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </ScrollViewer>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
